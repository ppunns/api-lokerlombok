# Salin ke .env dan isi nilainya. Jangan commit .env.
PORT=3000

# Opsional: origin browser yang boleh memanggil API (pisahkan dengan koma).
# Kosong = semua origin (API publik, hanya GET, tanpa cookie/login).
# CORS_ORIGINS=https://lokerlombok.example,http://localhost:5173

# Postgres connection string (Supabase → Connect → Session pooler), server-side only.
DATABASE_URL=
# Opsional: role read-only untuk API publik (lihat docs/database.md). Kosong = pakai DATABASE_URL.
# API_DATABASE_URL=postgresql://api_readonly.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# Dipakai Supabase CLI (db push) dan untuk integrasi berikutnya.
SUPABASE_DB_PASSWORD=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key melewati RLS: hanya untuk backend, jangan pernah ke frontend.
SUPABASE_SECRET_KEY=

# Opsional: Postgres lokal untuk integration test (lihat README).
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/loker_test

# Instagram Business Discovery (lihat docs/instagram-access.md).
IG_USER_ID=
IG_ACCESS_TOKEN=
# Opsional: akun target dan jadwal polling collector (--watch).
# IG_TARGET_USERNAME=lokerlombok
# COLLECT_CRON=*/15 * * * *

# Untuk menukar token Instagram (Meta app → App settings → Basic). Rahasia.
META_APP_ID=
META_APP_SECRET=

# Gemini API (aistudio.google.com/apikey) untuk ekstraksi lowongan dari poster.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# Dipakai hanya saat model utama membalas 503 (sibuk).
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Opsional: lowongan hasil AI langsung tayang (default true). false = simpan sebagai draft untuk review.
# AUTO_PUBLISH=true

# Opsional: jadwal dan ukuran batch pipeline otomatis.
# PIPELINE_CRON=*/15 * * * *
# EXTRACT_BATCH=20
